{
  "name": "backpack-brawl-optimizer",
  "version": "0.1.0",
  "private": true,
  "description": "Backpack Brawl Optimizer — парсер Wiki и строгая модель эффектов",
  "type": "module",
  "scripts": {
    "parse:items": "tsx scripts/wiki-parser/index.ts",
    "analyze:corpus": "tsx scripts/wiki-parser/analyze-corpus.ts",
    "test": "vitest run",
    "test:parser": "vitest run scripts/wiki-parser",
    "test:inventory": "vitest run src/lib/inventory",
    "test:scoring": "vitest run src/lib/scoring",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "test:optimizer": "vitest run src/lib/optimizer",
    "test:ui": "vitest run src/lib/ui src/components",
    "benchmark:optimizer": "tsx scripts/optimizer-stage8-report.ts",
    "benchmark:optimizer:stage9": "tsx scripts/optimizer-stage9-report.ts",
    "benchmark:optimizer:stage10": "tsx scripts/optimizer-stage10-report.ts",
    "benchmark:optimizer:stage11": "tsx scripts/optimizer-stage11-report.ts",
    "benchmark:optimizer:stage12": "tsx scripts/optimizer-stage12-report.ts",
    "benchmark:optimizer:stage13": "tsx scripts/optimizer-stage13-report.ts",
    "benchmark:optimizer:stage14": "tsx scripts/optimizer-stage14-report.ts",
    "benchmark:optimizer:stage15": "tsx scripts/optimizer-stage15-report.ts",
    "benchmark:optimizer:stage15:full": "tsx scripts/optimizer-stage15-report.ts --full",
    "benchmark:optimizer:stage16": "tsx scripts/optimizer-stage16-report.ts",
    "benchmark:optimizer:stage16:profile": "tsx scripts/optimizer-stage16-profile.ts",
    "benchmark:optimizer:stage17": "tsx scripts/optimizer-stage17-report.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "^15.5.9",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
